{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tracks: which standard each non-game page is held to",
  "type": "object",
  "required": ["game_prefixes", "tracks"],
  "additionalProperties": false,
  "properties": {
    "note": {"type": "string"},
    "game_prefixes": {
      "type": "array",
      "items": {"enum": ["traveller/", "astral-dawn/", "maps/", "s1*-prep/"]},
      "minItems": 4, "maxItems": 4, "uniqueItems": true
    },
    "tracks": {
      "type": "object",
      "required": ["science", "how-we-work"],
      "additionalProperties": false,
      "properties": {
        "science": {"$ref": "#/$defs/pages"},
        "how-we-work": {"$ref": "#/$defs/pages"}
      }
    }
  },
  "$defs": {
    "pages": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*\\.html$"}}
  }
}
